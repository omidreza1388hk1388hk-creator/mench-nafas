<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: chat shortcuts published by ShortcutPublisher carry this category, so they show up
     as sharing targets in the system share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.omidgame.mench.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <category android:name="com.omidgame.mench.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
