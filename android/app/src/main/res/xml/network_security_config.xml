<?xml version="1.0" encoding="utf-8"?>
<!-- Enforces TLS for all production traffic. Cleartext is permitted only
     for 10.0.2.2 (the Android emulator's alias for the host machine),
     so local backend development works without weakening the policy for
     real devices or production hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
