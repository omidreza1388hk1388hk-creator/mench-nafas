# ==========================================================
# MENCH Backend — Environment Configuration (Phase 1-6)
# Copy to .env and fill real values. NEVER commit .env.
# ==========================================================

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://mench:mench@localhost:5432/mench_dev

# Redis (rate limiting, OTP throttling, session cache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OTP
# In development, OTP_PROVIDER=dev logs the OTP to server console
# instead of sending a real SMS. NEVER use OTP_PROVIDER=dev in production.
OTP_PROVIDER=dev
OTP_TTL_SECONDS=120
OTP_LENGTH=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Real SMS provider (required when OTP_PROVIDER=sms)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Kavenegar OTP delivery (set OTP_PROVIDER=kavenegar to use this instead of
# the dev/sms providers above). Requires a Kavenegar account (free signup
# credit is enough for low-volume personal use) and a Verify Lookup
# template created in the Kavenegar panel with a single %token% placeholder.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# GIF search (Phase 2A) — Giphy, since Tenor's API was shut down on 2026-06-30.
# Create an API key at https://developers.giphy.com (a beta key is rate limited;
# Giphy requires approval before production use). Leave empty to disable GIFs.
GIPHY_API_KEY=
GIPHY_RATING=pg-13

# Location preview map tiles (Phase 2A). Empty = OpenStreetMap's public tile server
# (fine for a two-person app; their policy wants an identifying User-Agent).
MAP_TILE_URL_TEMPLATE=
MAP_TILE_USER_AGENT=MENCH-private-messenger/1.0 (contact: you@example.com)

# Object storage / attachments
# STORAGE_PROVIDER=local writes to disk under STORAGE_LOCAL_DIR — fine for
# development, forbidden in production (env.validation.ts enforces this,
# same as OTP_PROVIDER=dev). A real S3-compatible provider must be added
# (see backend/src/storage/) before STORAGE_PROVIDER=s3 can be used.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
MAX_ATTACHMENT_SIZE_BYTES=62914560
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
# Cloudflare R2 quick-start: create a bucket in the Cloudflare dashboard,
# then an R2 API token (Account > R2 > Manage API Tokens). S3_ENDPOINT is
# https://<account-id>.r2.cloudflarestorage.com — leave S3_REGION=auto.
# Free tier (10GB, no egress fees) is plenty for a two-person messenger.

# Phone allowlist — set this for a private (non-public) messenger so only
# your two numbers can ever register. Comma-separated E.164.
# ALLOWED_PHONE_NUMBERS=+989121234567,+15551234567

# WebRTC ICE servers (Phase 6 — calls)
# STUN_URLS has a working default (public Google STUN) so calls between
# two directly-reachable/simple-NAT devices connect with no setup. TURN is
# required for real-world NAT/firewall traversal and has no default — set
# up a TURN provider (e.g. coturn you run yourself, or a managed service)
# before relying on calls working across arbitrary networks. May be a
# comma-separated list of TURN URLs sharing one username/credential.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Push notifications (Phase 6)
# NOTIFICATIONS_PROVIDER=dev logs what would have been sent instead of
# calling Firebase — safe to leave as-is in development, and even in
# production if you haven't set up Firebase yet: messaging keeps working
# fully either way, it just means no push notifications are delivered.
# Unlike OTP_PROVIDER=dev, NOTIFICATIONS_PROVIDER=dev is NOT forbidden in
# production (see env.validation.ts) — pushing is an enhancement, OTP is
# not optional.
NOTIFICATIONS_PROVIDER=dev
# Required when NOTIFICATIONS_PROVIDER=fcm. Get these from a Firebase
# service account: Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key. That JSON file contains
# project_id, client_email, and private_key — copy those three fields
# here. FIREBASE_PRIVATE_KEY commonly needs its real newlines escaped as
# literal "\n" when stored as a single-line env var; the app un-escapes
# this automatically (see fcm-notification.provider.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Message translation (optional). Any LibreTranslate-compatible endpoint, e.g. https://libretranslate.example/translate.
# Leave TRANSLATE_URL empty to disable; the app then shows "translation is not available".
TRANSLATE_URL=
TRANSLATE_API_KEY=
